# Liga o MSW (API REST e Socket.IO simulados). Padrão: true. Use "false" para apontar para um backend real.
VITE_ENABLE_MOCKS=true
# URL base da API REST. Padrão: /api
VITE_API_URL=/api
# Origem do servidor Socket.IO (o cliente usa o path /realtime). Padrão: a própria origem da aplicação.
# VITE_SOCKET_URL=https://realtime.exemplo.com
